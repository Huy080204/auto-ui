            <column name="created_date" valueDate="2026-01-01T00:00:00"/>
            <column name="modified_by" value="system"/>
            <column name="modified_date" valueDate="2026-01-01T00:00:00"/>
            <column name="status" valueNumeric="1"/>
        </insert>
    </changeSet>
</databaseChangeLog>
